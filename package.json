  "main": "app.js",
  "scripts": {
    "dev": "tailwindcss -i ./input.css -o ./styles.css --watch",
    "build": "tailwindcss -i ./input.css -o ./styles.css --minify",
    "dev:v4": "tailwindcss -c ./tailwind.config.v4.js -i ./input-v4.css -o ./styles-v4.css --watch",
